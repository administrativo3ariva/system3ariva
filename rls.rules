  generated_at timestamptz NOT NULL DEFAULT now()
);

-- =========================================================
-- HABILITAR RLS + POLÍTICAS PADRÃO is_ativo()
-- =========================================================
DO $$
DECLARE t text;
BEGIN
  FOR t IN SELECT unnest(ARRAY[
    'assets','collaborators','expenses','maintenance_tasks',
    'nf_uploads','nf_items','operational_budgets_monthly',
    'operational_expenses','payment_requests','products',
    'stock_movements','suppliers','recurring_expenses','recurring_expense_runs'
  ]) LOOP
    EXECUTE format('ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY;', t);
    EXECUTE format($f$CREATE POLICY "Ativo can read %1$s" ON public.%1$I FOR SELECT TO authenticated USING (public.is_ativo());$f$, t);
    EXECUTE format($f$CREATE POLICY "Ativo can insert %1$s" ON public.%1$I FOR INSERT TO authenticated WITH CHECK (public.is_ativo());$f$, t);
    EXECUTE format($f$CREATE POLICY "Ativo can update %1$s" ON public.%1$I FOR UPDATE TO authenticated USING (public.is_ativo()) WITH CHECK (public.is_ativo());$f$, t);
    EXECUTE format($f$CREATE POLICY "Ativo can delete %1$s" ON public.%1$I FOR DELETE TO authenticated USING (public.is_ativo());$f$, t);
  END LOOP;
END$$;

-- =========================================================
-- TRIGGER DE ESTOQUE
-- =========================================================
CREATE TRIGGER trg_stock_movements_update_product
AFTER INSERT OR UPDATE OR DELETE ON public.stock_movements
FOR EACH ROW EXECUTE FUNCTION public.update_product_quantity();

-- =========================================================
-- GRANTS (Data API / PostgREST)
-- =========================================================
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO authenticated;
GRANT ALL ON ALL TABLES IN SCHEMA public TO service_role;
GRANT SELECT ON public.user_roles TO authenticated;
